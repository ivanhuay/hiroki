{
  "name": "hiroki-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "docs:dev": "vitepress dev mkdocs",
    "docs:build": "vitepress build mkdocs",
    "docs:preview": "vitepress preview mkdocs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ivanhuay/hiroki",
    "web": "https://github.com/ivanhuay/hiroki"
  }
}
